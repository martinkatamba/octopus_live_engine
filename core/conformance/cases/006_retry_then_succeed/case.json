{
  "description": "A step that fails twice and then succeeds completes within max_attempts: 3, and its trace records 3 attempts.",
  "workflow": "conf_retry_then_succeed",
  "activities": {
    "Flaky": [{"fail": "transient"}, {"fail": "transient"}, {"return": {"ok": true}}]
  },
  "runs": [
    {
      "input": {},
      "expect": {
        "status": "COMPLETED",
        "data": {"ok": true},
        "traces": [{"step_id": "step_flaky", "status": "COMPLETED", "attempts": 3}],
